@startuml SEQ06-recuperar-senha
title UC-03: Recuperar Senha\nChessMate - Plataforma de Xadrez Online

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2C3E50
  ActorBorderColor #2C3E50
  ActorBackgroundColor #D5E8D4
  LifeLineBorderColor #2980B9
  LifeLineBackgroundColor #EBF5FB
  ParticipantBorderColor #2980B9
  ParticipantBackgroundColor #EBF5FB
  BoxBackgroundColor #F2F3F4
  BoxBorderColor #BDC3C7
}

actor "Jogador" as Jogador
participant "Interface\nWeb" as UI
participant "AuthController" as AuthCtrl
participant "AuthService" as AuthSvc
participant "UsuarioRepository" as UsuarioRepo
participant "TokenRepository" as TokenRepo
database "Banco de Dados" as BD
participant "EmailService" as EmailSvc

== Solicitação de Recuperação ==

Jogador -> UI : informarEmail(email)
activate UI

UI -> AuthCtrl : POST /api/auth/recuperar-senha\n{ email }
activate AuthCtrl

AuthCtrl -> AuthSvc : solicitarRecuperacao(email)
activate AuthSvc

AuthSvc -> UsuarioRepo : buscarPorEmail(email)
activate UsuarioRepo
UsuarioRepo -> BD : SELECT * FROM usuarios\nWHERE email = ?
activate BD
BD --> UsuarioRepo : usuarioEncontrado
deactivate BD
UsuarioRepo --> AuthSvc : usuario
deactivate UsuarioRepo

AuthSvc -> AuthSvc : gerarTokenRecuperacao()
activate AuthSvc
note right of AuthSvc : Gera token UUID único\ncom expiração de 1 hora
AuthSvc --> AuthSvc : token
deactivate AuthSvc

AuthSvc -> TokenRepo : salvarToken(\n  usuarioId, token, expiracao)
activate TokenRepo
TokenRepo -> BD : INSERT INTO tokens_recuperacao\n(usuario_id, token,\nexpiracao, criado_em)
activate BD
BD --> TokenRepo : tokenSalvo
deactivate BD
TokenRepo --> AuthSvc : tokenPersistido
deactivate TokenRepo

AuthSvc ->> EmailSvc : enviarEmailRecuperacao(\n  email, token)
activate EmailSvc
note right of EmailSvc : Envia link assíncrono:\n/redefinir-senha?token=...
EmailSvc --> AuthSvc : emailEnviado
deactivate EmailSvc

AuthSvc --> AuthCtrl : solicitacaoRegistrada
deactivate AuthSvc

AuthCtrl --> UI : HTTP 200 OK\n{ mensagem: "E-mail enviado\nse cadastro existir" }
deactivate AuthCtrl

UI --> Jogador : exibirMensagem(\n  "Verifique seu e-mail")
deactivate UI

== Redefinição de Senha ==

Jogador -> UI : acessarLink(token)\ne informar novaSenha
activate UI

UI -> AuthCtrl : POST /api/auth/redefinir-senha\n{ token, novaSenha }
activate AuthCtrl

AuthCtrl -> AuthSvc : redefinirSenha(token, novaSenha)
activate AuthSvc

AuthSvc -> TokenRepo : buscarToken(token)
activate TokenRepo
TokenRepo -> BD : SELECT * FROM tokens_recuperacao\nWHERE token = ?\nAND expiracao > NOW()
activate BD
BD --> TokenRepo : tokenValido
deactivate BD
TokenRepo --> AuthSvc : tokenEncontrado(usuarioId)
deactivate TokenRepo

AuthSvc -> AuthSvc : hashNovaSenha(novaSenha)
activate AuthSvc
AuthSvc --> AuthSvc : novaSenhaHash
deactivate AuthSvc

AuthSvc -> UsuarioRepo : atualizarSenha(usuarioId, novaSenhaHash)
activate UsuarioRepo
UsuarioRepo -> BD : UPDATE usuarios\nSET senha_hash = ?\nWHERE id = ?
activate BD
BD --> UsuarioRepo : atualizado
deactivate BD
UsuarioRepo --> AuthSvc : senhaAtualizada
deactivate UsuarioRepo

AuthSvc -> TokenRepo : invalidarToken(token)
activate TokenRepo
TokenRepo -> BD : DELETE FROM tokens_recuperacao\nWHERE token = ?
activate BD
BD --> TokenRepo : removido
deactivate BD
TokenRepo --> AuthSvc : tokenInvalidado
deactivate TokenRepo

AuthSvc --> AuthCtrl : senhaRedefinida
deactivate AuthSvc

AuthCtrl --> UI : HTTP 200 OK\n{ mensagem: "Senha redefinida\ncom sucesso" }
deactivate AuthCtrl

UI --> Jogador : redirecionar para Login
deactivate UI

@enduml
