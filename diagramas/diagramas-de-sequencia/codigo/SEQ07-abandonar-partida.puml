@startuml SEQ07-abandonar-partida
title UC-08: Abandonar Partida\nChessMate - Plataforma de Xadrez Online

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2C3E50
  ActorBorderColor #2C3E50
  ActorBackgroundColor #D5E8D4
  LifeLineBorderColor #2980B9
  LifeLineBackgroundColor #EBF5FB
  ParticipantBorderColor #2980B9
  ParticipantBackgroundColor #EBF5FB
  BoxBackgroundColor #F2F3F4
  BoxBorderColor #BDC3C7
}

actor "Jogador" as Jogador
actor "Adversário" as Adversario
participant "Interface\nWeb" as UI
participant "PartidaController" as PartidaCtrl
participant "PartidaService" as PartidaSvc
participant "PartidaRepository" as PartidaRepo
database "Banco de Dados" as BD
participant "RatingService" as RatingSvc
participant "WebSocketService" as WSSvc

Jogador -> UI : clicarAbandonar()
activate UI

UI -> UI : exibirConfirmacao(\n  "Tem certeza? Você perderá Elo.")
UI --> Jogador : aguardar confirmação

Jogador -> UI : confirmarAbandono()

UI -> PartidaCtrl : POST /api/partidas/{id}/abandonar\n{ usuarioId }
activate PartidaCtrl

PartidaCtrl -> PartidaSvc : abandonarPartida(partidaId, usuarioId)
activate PartidaSvc

PartidaSvc -> PartidaRepo : buscarPartida(partidaId)
activate PartidaRepo
PartidaRepo -> BD : SELECT * FROM partidas\nWHERE id = ? AND status = 'EM_ANDAMENTO'
activate BD
BD --> PartidaRepo : partidaEncontrada
deactivate BD
PartidaRepo --> PartidaSvc : partida
deactivate PartidaRepo

PartidaSvc -> PartidaRepo : finalizarPartida(\n  partidaId, resultado, motivo)
activate PartidaRepo
PartidaRepo -> BD : UPDATE partidas\nSET status = 'ABANDONADA',\nresultado = 'VITORIA_ADVERSARIO',\ndata_fim = NOW()\nWHERE id = ?
activate BD
BD --> PartidaRepo : atualizado
deactivate BD
PartidaRepo --> PartidaSvc : partidaFinalizada
deactivate PartidaRepo

PartidaSvc -> RatingSvc : recalcularElo(\n  perdedorId, vencedorId)
activate RatingSvc
note right of RatingSvc : Aplica fórmula Elo:\nK-factor por categoria\nde rating
RatingSvc -> PartidaRepo : atualizarRatings(\n  jogador1, jogador2)
activate PartidaRepo
PartidaRepo -> BD : UPDATE partida_jogadores\nSET rating_depois = ?\nWHERE partida_id = ?
activate BD
BD --> PartidaRepo : atualizado
deactivate BD
PartidaRepo --> RatingSvc : ratingsAtualizados
deactivate PartidaRepo
RatingSvc --> PartidaSvc : eloRecalculado
deactivate RatingSvc

PartidaSvc --> PartidaCtrl : abandonoRegistrado(resultado)
deactivate PartidaSvc

PartidaCtrl ->> WSSvc : notificarFimDeJogo(\n  partidaId, ABANDONO)
activate WSSvc
note right of WSSvc : Notifica adversário\nassincronamente
WSSvc --> PartidaCtrl : notificado
deactivate WSSvc

PartidaCtrl --> UI : HTTP 200 OK\n{ resultado: "Derrota por abandono",\n  eloAlterado: -12 }
deactivate PartidaCtrl

UI --> Jogador : exibirResultado(\n  "Você abandonou. -12 Elo")
deactivate UI

WSSvc -> UI : eventoAbandono(\n  "Adversário abandonou!\n+12 Elo")
activate UI
UI --> Adversario : exibirResultado(\n  "Você venceu por W.O.! +12 Elo")
deactivate UI

@enduml
