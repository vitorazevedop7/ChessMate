@startuml DSS-UC03-recuperar-senha
title DSS - UC-03: Recuperar Senha\nChessMate - Plataforma de Xadrez Online (Visão de Sistema)

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2C3E50
  ActorBorderColor #2C3E50
  ActorBackgroundColor #D5E8D4
  LifeLineBorderColor #2980B9
  LifeLineBackgroundColor #EBF5FB
  ParticipantBorderColor #2980B9
  ParticipantBackgroundColor #EBF5FB
  BoxBackgroundColor #F2F3F4
  BoxBorderColor #BDC3C7
}

note over Sistema
  <<Sistema>>
  ChessMate
  (caixa preta)
end note

actor "Jogador" as U
participant "Sistema\nChessMate" as Sistema

== Solicitação de Recuperação ==

U -> Sistema : solicitarRecuperacaoSenha(email)
activate Sistema

alt E-mail cadastrado
  Sistema --> U : confirmacaoEnvio(\n  "E-mail de recuperação enviado.")
  Sistema ->> U : enviarEmailRecuperacao(token)
else E-mail não encontrado
  Sistema --> U : notificarErro(\n  "E-mail não encontrado.")
end
deactivate Sistema

== Redefinição de Senha ==

U -> Sistema : redefinirSenha(token, novaSenha)
activate Sistema

alt Token válido e não expirado
  Sistema --> U : senhaAtualizada(\n  "Senha alterada com sucesso!")
else Token inválido ou expirado
  Sistema --> U : notificarErro(\n  "Token inválido ou expirado.\nSolicite novo e-mail.")
end
deactivate Sistema

@enduml
