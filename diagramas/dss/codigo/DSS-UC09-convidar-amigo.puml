@startuml DSS-UC09-convidar-amigo
title DSS - UC-09: Convidar Amigo para Partida\nChessMate - Plataforma de Xadrez Online (Visão de Sistema)

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2C3E50
  ActorBorderColor #2C3E50
  ActorBackgroundColor #D5E8D4
  LifeLineBorderColor #2980B9
  LifeLineBackgroundColor #EBF5FB
  ParticipantBorderColor #2980B9
  ParticipantBackgroundColor #EBF5FB
  BoxBackgroundColor #F2F3F4
  BoxBorderColor #BDC3C7
}

note over Sistema
  <<Sistema>>
  ChessMate
  (caixa preta)
end note

actor "Jogador" as U
actor "Amigo" as A
participant "Sistema\nChessMate" as Sistema

U -> Sistema : selecionarAmigo(amigoId, modalidade)
activate Sistema
Sistema --> U : exibirResumoConvite(\n  amigo, modalidade, tempoControle)
deactivate Sistema

U -> Sistema : enviarConvite(amigoId, modalidade)
activate Sistema

alt Amigo disponível
  Sistema --> U : conviteEnviado(\n  "Aguardando resposta do amigo...")
  Sistema ->> A : notificarConvite(\n  "Você recebeu um convite de partida!")
else Amigo offline ou indisponível
  Sistema --> U : notificarErro(\n  "Amigo indisponível no momento.")
end
deactivate Sistema

== Resposta ao Convite ==

A -> Sistema : aceitarConvite(conviteId)
activate Sistema

alt Convite aceito
  Sistema --> A : partidaCriada(partidaId, cor)
  Sistema ->> U : notificarAceite(\n  "Amigo aceitou! Partida iniciada.")
else Convite recusado
  Sistema --> A : conviteRecusado()
  Sistema ->> U : notificarRecusa(\n  "Amigo recusou o convite.")
end
deactivate Sistema

@enduml
