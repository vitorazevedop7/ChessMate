@startuml DSS-UC02-autenticar
title DSS - UC-02: Autenticar (Login)\nChessMate - Plataforma de Xadrez Online (Visão de Sistema)

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2C3E50
  ActorBorderColor #2C3E50
  ActorBackgroundColor #D5E8D4
  LifeLineBorderColor #2980B9
  LifeLineBackgroundColor #EBF5FB
  ParticipantBorderColor #2980B9
  ParticipantBackgroundColor #EBF5FB
  BoxBackgroundColor #F2F3F4
  BoxBorderColor #BDC3C7
}

note over Sistema
  <<Sistema>>
  ChessMate
  (caixa preta)
end note

actor "Jogador" as U
participant "Sistema\nChessMate" as Sistema

U -> Sistema : informarCredenciais(email, senha)
activate Sistema

alt Credenciais válidas e conta ativa
  Sistema --> U : loginRealizado(\n  token, nome, ratingElo)
else Senha incorreta
  Sistema --> U : notificarErro(\n  "Credenciais inválidas.")
else Conta suspensa
  Sistema --> U : notificarErro(\n  "Conta suspensa. Entre em contato.")
else Conta pendente de confirmação
  Sistema --> U : notificarErro(\n  "Confirme seu e-mail antes de entrar.")
end
deactivate Sistema

@enduml
