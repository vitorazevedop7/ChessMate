@startuml DSS-UC07-jogar-partida
title DSS - UC-07: Jogar Partida\nChessMate - Plataforma de Xadrez Online (Visão de Sistema)

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam backgroundColor #FAFAFA
skinparam sequence {
  ArrowColor #2C3E50
  ActorBorderColor #2C3E50
  ActorBackgroundColor #D5E8D4
  LifeLineBorderColor #2980B9
  LifeLineBackgroundColor #EBF5FB
  ParticipantBorderColor #2980B9
  ParticipantBackgroundColor #EBF5FB
  BoxBackgroundColor #F2F3F4
  BoxBorderColor #BDC3C7
}

note over Sistema
  <<Sistema>>
  ChessMate
  (caixa preta)
end note

actor "Jogador" as U
actor "Adversário" as A
participant "Sistema\nChessMate" as Sistema

U -> Sistema : moverPeca(origem, destino)
activate Sistema

alt Movimento válido e jogo em andamento
  Sistema --> U : movimentoRegistrado(notacaoPGN, turnoAdversario)
  Sistema ->> A : notificarMovimento(tabuleiro, turnoAtual)
else Movimento inválido
  Sistema --> U : notificarErro("Movimento inválido.")
end
deactivate Sistema

== Fim de Jogo ==

U -> Sistema : moverPeca(xeque-mate)
activate Sistema

alt Vitória por xeque-mate
  Sistema --> U : exibirResultado("Você venceu! +15 Elo")
  Sistema ->> A : exibirResultado("Você perdeu. -15 Elo")
else Empate por acordo
  Sistema --> U : exibirResultado("Empate! Elo inalterado.")
  Sistema ->> A : exibirResultado("Empate! Elo inalterado.")
end
deactivate Sistema

@enduml
